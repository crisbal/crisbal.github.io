---
import Layout from '../layouts/Layout.astro';
import resumeData from '../data/resume.yaml';

const { meta, sections } = resumeData;
---

<Layout title="Resume">
    <!-- Font loading -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;1,300&display=swap" slot="head" />

    <div class="max-w-[1140px] mx-auto px-6 py-6 md:px-8 md:py-8 bg-[var(--background-color)] shadow-sm font-['Ubuntu'] font-light text-base md:text-xl leading-[1.2]">
        <!-- Header -->
        <header class="text-center md:text-center hidden md:block">
            <div class="inline-block text-left">
                <div class="flex items-center">
                    <h1 class="text-[2.8em] font-normal text-[var(--slate)] leading-[0.8]">{meta.name}</h1>
                    <div class="text-left ml-3">
                        {meta.links.map((link) => (
                        <a href={link.href} target="_blank" class="block text-[var(--link-color)] hover:underline">
                            {link.text}
                        </a>
                        ))}
                    </div>
                </div>
                <div class="text-[1.4em] font-normal text-[#868686] ml-1">{meta.claim}</div>
            </div>
        </header>

         <!-- Mobile Header (simplified based on original Vue responsive logic) -->
         <header class="text-left block md:hidden mb-8">
            <h1 class="text-4xl font-normal text-[var(--slate)] leading-none mb-2">{meta.name}</h1>
            <div class="text-lg text-[#868686] mb-4">{meta.claim}</div>
            <div class="flex flex-col gap-1">
                {meta.links.map((link) => (
                <a href={link.href} target="_blank" class="text-[var(--link-color)] hover:underline">
                    {link.text}
                </a>
                ))}
            </div>
        </header>

        <!-- Sections -->
        <div class="block md:grid gap-8" style={{
            gridTemplateAreas: `"Experience Experience" "Education Education" "Skills PersonalProjects" "Skills Other"`,
            gridTemplateColumns: "1fr 1fr"
        }}>
            {sections.map((section) => (
                <div class="mb-5 md:mb-0" style={{
                    gridArea: section.title.replace(/ /g, '')
                }}>
                    <h2
                    class={`font-light border-b-0 mb-[0.2rem] ${section.extra?.includes('smallTitle') ? 'text-[1.4em]' : 'text-[1.9em]'}`}
                    style={{ color: section.titleColor }}
                    >
                        {section.title}
                    </h2>

                    {/* Type: Entries (Experience, Education) */}
                    {section.type === 'entries' && (
                        <div>
                            {section.entries.map((entry) => (
                                <div class="flex flex-col md:flex-row mb-2 md:mb-[0.5em]">
                                    <div class="md:basis-[22%] pr-4">
                                        <div class="font-normal text-[1.1em] text-[var(--text-color)]">{entry.place}</div>
                                        <div class="text-[0.8em] text-[#868686]">{entry.date}</div>
                                    </div>
                                    <div class="flex-1">
                                        <div class="font-normal text-[var(--slate)]">{entry.title}</div>
                                        {entry.details && (
                                            <ul class="list-none pl-[0.5em] m-0 leading-[1.3]">
                                                {entry.details.map((detail) => (
                                                    <li class="-indent-3 pl-3 before:content-['•'] before:mr-2">{detail}</li>
                                                ))}
                                            </ul>
                                        )}
                                    </div>
                                </div>
                            ))}
                        </div>
                    )}

                    {/* Type: Items (Skills, Projects, Other) */}
                    {section.type === 'items' && (
                        <div class={`
                            ${section.extra?.includes('breath') ? 'leading-[1.25]' : ''}
                            ${section.extra?.includes('margin-bottom') ? '[&_li]:mb-2' : ''}
                        `}>
                            {(section.subsections || [{ items: section.items }]).map((subsection) => (
                                <>
                                    {subsection.name && <div class="mt-3 first:mt-0 font-normal">{subsection.name}</div>}
                                    <ul class={`
                                        ${section.extra?.includes('no-bullet') ? 'list-none pl-0' : 'list-none'}
                                    `}>
                                        {subsection.items.map((item) => (
                                            <li class={`
                                                ${!section.extra?.includes('no-bullet') ? '-indent-3 pl-3 before:content-["•"] before:mr-2' : ''}
                                            `}>
                                                <span class="font-normal">{item.title}&nbsp;</span>
                                                {section.extra?.includes('compact') ? (
                                                    <>
                                                        <span class="text-[0.9em]">{item.text}&nbsp;</span>
                                                        {item.description && <span class="text-[0.8em] text-[#868686]">{item.description}</span>}
                                                    </>
                                                ) : (
                                                    <>
                                                        {item.description && (
                                                            <>
                                                                <span class="text-[0.8em] text-[#868686]">{item.description}</span>
                                                                <br />
                                                            </>
                                                        )}
                                                        <span class="text-[0.9em]">{item.text}</span>
                                                    </>
                                                )}
                                            </li>
                                        ))}
                                    </ul>
                                </>
                            ))}
                        </div>
                    )}
                </div>
            ))}
        </div>

        <div class="text-center md:text-right mt-4 md:mt-4 hidden md:block print:hidden">
            <a href="/Cristian Baldi - Resume.pdf" target="_blank" class="inline-flex items-center px-6 py-2 shadow-sm rounded-full bg-[var(--background-color)] text-[var(--text-color)] hover:bg-[var(--light-gray)] transition-colors duration-100 ease-linear cursor-pointer no-underline">
                <i class="mdi mdi-download mr-2"></i> Download as PDF
            </a>
        </div>

         <div class="text-center mt-8 mb-8 block md:hidden print:hidden">
            <a href="/Cristian Baldi - Resume.pdf" target="_blank" class="inline-flex items-center px-6 py-2 border border-[#cfcfcf] text-base font-medium rounded-[3rem] text-[var(--text-color)] bg-[var(--background-color)] hover:bg-[var(--light-gray)] transition-all duration-100 ease-linear no-underline cursor-pointer">
                <i class="mdi mdi-download mr-2"></i> Download PDF
            </a>
        </div>
    </div>
</Layout>
