---
import Layout from '../layouts/Layout.astro';
import resumeData from '../data/resume.yaml';

const { meta, sections } = resumeData;

const parseText = (text) => {
  if (typeof text !== 'string') return text;
  return text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
};
---

<Layout title="Resume" isResume={true}>
    <!-- Font loading -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;1,300&display=swap" slot="head" />

    <div class="max-w-[1140px] mx-auto px-6 py-6 md:px-8 md:py-8 bg-[var(--background-color)] shadow-sm font-['Ubuntu'] font-light text-base md:text-xl leading-[1.2] print:max-w-none print:shadow-none print:bg-white print:p-8 print:text-[11pt] print:mx-0">
        <!-- Header -->
        <header class="text-center">
            <div class="inline-block text-left">
                <div class="flex items-center">
                    <h1 class="text-[2.5em] font-normal text-[var(--slate)] leading-[0.8]">{meta.name}</h1>
                    <div class="text-left ml-3">
                        {meta.links.map((link) => (
                        <a href={link.href} target="_blank" class="block text-[var(--link-color)] hover:underline">
                            {link.text}
                        </a>
                        ))}
                    </div>
                </div>
                <div class="text-[1.4em] font-normal text-[#868686] ml-1">{meta.claim}</div>
            </div>
        </header>

        <!-- Sections -->
        <div class="block">
            {sections.map((section) => (
                <div class="mb-3">
                    <h2
                    class={[
                      `font-bold mb-1`,
                      section.customizations.includes('smalltitle') ? 'text-[1em]' : 'text-[1.25em] ',
                    ].join(' ')}
                    style={{ color: section.titleColor }}
                    >
                        {section.title}
                    </h2>

                    <div class="ml-2">
                        {section.entries && section.entries.map((item) => (
                            <div class="mb-2 last:mb-0">
                                <div class="flex items-baseline">
                                    <div class="flex-1 flex items-baseline">
                                        <h3 class="font-bold">{item.title}</h3>
                                        {item.description && <span class="">&nbsp;- {item.description}</span>}
                                        {item.link && <span>&nbsp;- <a href={item.link.href} target="_blank" class="text-[var(--link-color)] hover:underline text-[0.9em]">{item.link.text}</a></span>}
                                    </div>
                                    {item.date &&
                                      <div>
                                        <div class="text-right text-[var(--dark-gray)] text-[0.8em]">{item.date}</div>
                                      </div>
                                    }
                                </div>
                                <div class="ml-3 leading-normal">
                                    {item.bullets &&
                                    <ul class="list-disc ml-3">
                                        {item.bullets.map((content) => (
                                            <li class="text-[0.95em]" set:html={parseText(content)} />
                                        ))}
                                    </ul>
                                    }
                                    {item.paragraphs &&
                                    <div>
                                        {item.paragraphs.map((content) => (
                                            <p class="text-[0.95] mb-1" set:html={parseText(content)} />
                                        ))}
                                    </div>
                                    }
                                </div>
                            </div>
                        ))}
                        {section.bullets && (
                            <div class="ml-3 leading-normal">
                                <ul class="list-disc">
                                    {section.bullets.map((bullet) => (
                                        <li class="text-1em">
                                            <span class="font-bold">{bullet.title}</span>
                                            {bullet.description && <span>&nbsp;- {bullet.description}</span>}
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )}
                        {section.columns && (
                        <div class="grid grid-cols-3">
                            {section.columns.map((col) => (
                                <div class="mb-2">
                                    <h3 class="font-bold">{col.title}</h3>
                                    <span>{col.description}</span>
                                </div>
                            ))}
                        </div>
                        )}
                    </div>
                </div>
            ))}
        </div>
    </div>
    <div class="text-center mt-4 print:hidden">
        <a href="/Cristian Baldi - Resume.pdf" target="_blank" class="inline-flex items-center px-6 py-2 shadow-sm rounded-full bg-[var(--background-color)] text-[var(--text-color)] hover:bg-[var(--light-gray)] transition-colors duration-100 ease-linear cursor-pointer no-underline">
            <i class="mdi mdi-download mr-2"></i> Download as PDF
        </a>
    </div>
</Layout>
